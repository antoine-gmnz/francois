node_modules/
dist/
src-tauri/target/
src-tauri/gen/
.cartograph/

# npm distribution package: both are produced at publish time (npm-publish.yml)
packaging/npm/manifest.json
packaging/npm/vendor/

# OS / editor cruft
.DS_Store
Thumbs.db
.serena/

# pipeline build/review timing metrics — local only
.claude/pipeline-metrics.jsonl
pipeline-metrics.jsonl

# pipeline review/smoke staging buffer — ephemeral, regenerated every /review /smoke round
specs/reports/

# pipeline preflight phase-gate stamp + its command log — local only, regenerated by
# pipeline/scripts/preflight.sh
.claude/preflight.ok
.claude/preflight.log

# VitePress build output + cache (docs deploy via .github/workflows/docs.yml)
docs/.vitepress/dist/
docs/.vitepress/cache/

# capture scratch — frames and encodes for the README assets (scripts/capture)
.capture/

# local cargo test run logs — developer paths, never committed (multi-provider-seam review round 2)
.cargo-test.log
.claude/preflight-report.txt

# quality reports + coverage — regenerated by `npm run quality:report` and by
# .github/workflows/quality.yml, which uploads them as artifacts. Never committed:
# a checked-in report goes stale silently and starts getting believed.
reports/
