{
  "name": "francois",
  "private": true,
  "version": "0.34.4",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:app": "tauri build",
    "build:app:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deps": "eslint . --rule \"{'react-hooks/exhaustive-deps':'error'}\" --format stylish",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets",
    "lint:conventions": "node scripts/quality/check.mjs",
    "format": "cd src-tauri && cargo fmt",
    "format:check": "cd src-tauri && cargo fmt --check",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run lint && npm run lint:conventions && npm run format:check && npm run lint:rust",
    "quality:report": "node scripts/quality/report.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-notification": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^15.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
