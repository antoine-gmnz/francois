+fn git(dir: &std::path::Path, args: &[&str]) {
+    let status = Cmd::new("git")
+        .args(args)
+        .current_dir(dir)
+        .status()
+        .expect("git spawn");
+    assert!(status.success(), "git {args:?} failed in {dir:?}");
+}
