+fn status_of(dirty_count: u32, unpushed: bool, unpushed_count: u32) -> WorktreeStatusData {
+    WorktreeStatusData {
+        dirty: dirty_count > 0,
+        dirty_count,
+        unpushed,
+        unpushed_count,
+        upstream: None,
+    }
